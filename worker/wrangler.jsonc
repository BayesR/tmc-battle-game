{
  "name": "tmc-online",
  "main": "index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // 対戦ログ（運営者用の匿名統計）を使うときは、npx wrangler d1 create tmc-online-logs を実行し、表示された database_id を
  // 下の行に書いて、行頭の「//」を外す（手順は worker/README.md）。この行が無くても、サーバーは今までどおり動く。
  // "d1_databases": [{ "binding": "DB", "database_name": "tmc-online-logs", "database_id": "ここに表示されたIDを入れる" }],
  "vars": {
    // 接続を許可するサイト（カンマ区切り）。* は「英小文字・数字・ハイフン」にだけ一致する。
    //   - localhost:5173 … 自分のPCでの開発用
    //   - tmc-battle-game.vercel.app … 公開中のゲーム
    //   - tmc-battle-game-git-online-battle-bayes-r.vercel.app … Vercelの確認用デプロイ（ブランチ）
    //   - tmc-battle-game-*-bayes-r.vercel.app … Vercelの確認用デプロイ（コミットごとに発行されるURLも含む）
    "ALLOWED_ORIGINS": "http://localhost:5173,https://tmc-battle-game.vercel.app,https://tmc-battle-game-git-online-battle-bayes-r.vercel.app,https://tmc-battle-game-*-bayes-r.vercel.app",
    "ALLOW_SPECTATORS": "false",
    // 緊急停止スイッチ。"false" にして再デプロイ（npx wrangler deploy）すると、新しい接続を全て断る
    "ONLINE_ENABLED": "true",
    // 対戦ログ（運営者用の匿名統計）。"false" にすると記録を止める。LOG_RETENTION_DAYS は、残す日数
    "LOG_MATCHES": "true",
    "LOG_RETENTION_DAYS": "90"
  },
  // 毎日、保存期間を過ぎた対戦ログを削除する（18:00 UTC ＝ 日本時間の午前3時）
  "triggers": { "crons": ["0 18 * * *"] }
}
